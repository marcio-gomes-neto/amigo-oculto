# ============================================================
#  Amigo Oculto — configuração do backend
#  Copie este arquivo para "backend/.env" e preencha os valores.
# ============================================================

# Porta da API
PORT=3001

# Origem permitida para o frontend em desenvolvimento (separe várias por vírgula)
CORS_ORIGIN=http://localhost:5173

# Arquivo do banco de dados SQLite (relativo à pasta backend/). É criado automaticamente.
DATABASE_PATH=data/amigo-oculto.db

# ------------------------------------------------------------
#  Envio de email (Nodemailer)
# ------------------------------------------------------------

# Conta que vai enviar os emails do sorteio. Ex.: EMAIL_USER=seu.email@gmail.com
EMAIL_USER=

# Token de envio (sender token). No Gmail, use uma "Senha de app" de 16 letras
# gerada em https://myaccount.google.com/apppasswords (NÃO use sua senha normal).
# Ex.: EMAIL_TOKEN=abcdefghijklmnop
EMAIL_TOKEN=

# Nome que aparece como remetente
EMAIL_FROM_NAME=Amigo Oculto

# (Opcional) Endereço do remetente, se for diferente de EMAIL_USER.
# Necessário em provedores como SendGrid/Brevo, onde o usuário SMTP não é um email.
EMAIL_FROM=

# Serviço conhecido pelo Nodemailer (gmail, outlook365, yahoo, zoho...).
# Ignorado se SMTP_HOST estiver preenchido.
EMAIL_SERVICE=gmail

# (Opcional) Servidor SMTP personalizado. Se preenchido, substitui EMAIL_SERVICE.
# Exemplos: smtp.sendgrid.net (usuário "apikey"), smtp-relay.brevo.com, smtp.office365.com
SMTP_HOST=
SMTP_PORT=587
# true para porta 465 (SSL); false para 587 (STARTTLS)
SMTP_SECURE=false

# Modo de teste: se "true", NENHUM email é enviado. Cada email é salvo como
# arquivo .html em backend/outbox para você conferir o resultado.
EMAIL_DRY_RUN=false
